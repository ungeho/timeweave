# TimeWeave environment variables.
# Copy this file to `.env` and fill in your own values. Never commit `.env`.
#
# Leave BOTH unset to run in local mode (no auth, localStorage persistence).
# Set BOTH to run in Supabase mode (Google login + DB with RLS).

# Supabase Project URL, e.g. https://<project-ref>.supabase.co
VITE_SUPABASE_URL=

# Supabase anon / publishable key (public by design — RLS is the real defense).
# Accepts the JWT anon key (eyJ...) or the new publishable key (sb_publishable_...).
VITE_SUPABASE_ANON_KEY=
